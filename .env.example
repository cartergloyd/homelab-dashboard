# docker compose variables for the PostgreSQL + Directus stack.
# Copy to .env and change every value marked CHANGE-ME.
# [INSTALLER] placeholders throughout; DIRECTUS_PUBLIC_URL must be the server's real
# Tailscale MagicDNS name. Never commit the resulting .env.

POSTGRES_USER=homelab
POSTGRES_PASSWORD=CHANGE-ME
POSTGRES_DB=personal

# openssl rand -hex 32
DIRECTUS_SECRET=CHANGE-ME
DIRECTUS_ADMIN_EMAIL=you@example.com
DIRECTUS_ADMIN_PASSWORD=CHANGE-ME
# The address you will open Directus at (Tailscale MagicDNS name or 100.x address)
DIRECTUS_PUBLIC_URL=http://homeserver:8055
