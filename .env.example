# docker compose variables for the PostgreSQL + Directus-per-app + Cloudflare Tunnel stack.
# Copy to .env, change every CHANGE-ME, never commit the result.
# [INSTALLER] placeholders throughout. Generate passwords/secrets with: openssl rand -hex 32

# ---- where data lives (keep OUT of the source checkout so a re-clone cannot lose it) ----
PGDATA_DIR=/srv/homelab/pgdata
APPS_DATA_DIR=/srv/homelab/apps

# ---- PostgreSQL superuser + the owner's personal database (Directus on :8055, Tailscale only)
POSTGRES_USER=homelab
POSTGRES_PASSWORD=CHANGE-ME
POSTGRES_DB=personal
DIRECTUS_SECRET=CHANGE-ME
DIRECTUS_ADMIN_EMAIL=you@example.com
DIRECTUS_ADMIN_PASSWORD=CHANGE-ME
# The address you open the personal Directus at (Tailscale MagicDNS name or 100.x address)
DIRECTUS_PUBLIC_URL=http://homeserver:8055

# ---- public apps: one database + one Directus each, published by the tunnel -------------
# Your domain, on Cloudflare DNS. Each app's Directus is <name>-api.<domain> (tunnel); <name>.<domain>
# is the app's front-end (GitHub Pages today) and is NOT a tunnel hostname.
PUBLIC_DOMAIN=xgold.tech
# Comma-separated app names; deploy/postgres-init/01-apps.sh creates role+database per name on
# FIRST start. Adding one later: scripts/add-app.sh <name>.
APPS=fam,ai,crm

APP_FAM_DB_PASSWORD=CHANGE-ME
APP_FAM_SECRET=CHANGE-ME
APP_FAM_ADMIN_EMAIL=you@example.com
APP_FAM_ADMIN_PASSWORD=CHANGE-ME
# Browser origins allowed to call fam's API (comma-separated). Default: the app's site, https://fam.<domain>.
# APP_FAM_CORS_ORIGIN=https://fam.xgold.tech,http://localhost:5173

APP_AI_DB_PASSWORD=CHANGE-ME
APP_AI_SECRET=CHANGE-ME
APP_AI_ADMIN_EMAIL=you@example.com
APP_AI_ADMIN_PASSWORD=CHANGE-ME
# APP_AI_CORS_ORIGIN=https://ai.xgold.tech

# ---- Twenty CRM (crm.<domain>; SERVER_SETUP § 5.8) -------------------------------------
# [INSTALLER] pin to a release from https://hub.docker.com/r/twentycrm/twenty/tags (v2.38.1 was current in Oct 2026)
TWENTY_TAG=v2.38.1
# hex only — it is pasted into the Postgres URL unencoded: openssl rand -hex 32
APP_CRM_DB_PASSWORD=CHANGE-ME
# openssl rand -base64 32 — generated ONCE; losing it loses every secret Twenty stored (keep a copy in the password manager)
APP_CRM_ENCRYPTION_KEY=CHANGE-ME
# outbound e-mail for invites and password resets (optional). Gmail: smtp.gmail.com 465 + an App Password.
# TWENTY_EMAIL_DRIVER=smtp
# TWENTY_EMAIL_SMTP_HOST=smtp.gmail.com
# TWENTY_EMAIL_SMTP_PORT=465
# TWENTY_EMAIL_SMTP_USER=you@gmail.com
# TWENTY_EMAIL_SMTP_PASSWORD=app-password
# TWENTY_EMAIL_FROM_ADDRESS=you@gmail.com
# TWENTY_EMAIL_FROM_NAME=Twenty CRM

# ---- Cloudflare Tunnel ------------------------------------------------------------------
# Zero Trust → Networks → Tunnels → Create a tunnel (Cloudflared) → copy the token shown in
# the "install connector" command (the long string after --token). The connector runs on the
# host network and routes hostnames to 127.0.0.1:<port> (SERVER_SETUP § 5.2).
CLOUDFLARE_TUNNEL_TOKEN=CHANGE-ME
