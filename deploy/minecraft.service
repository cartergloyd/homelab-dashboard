# [INSTALLER] PLACEHOLDER TEMPLATE — do not install blindly.
# The live server already runs Paper. First check how: `systemctl list-units | grep -i mine`,
# `ps -ef | grep -i paper`. If a unit already exists, use ITS name as MC_SERVICE and leave
# this file alone (at most add KillSignal/TimeoutStopSec via `systemctl edit`).
# Only if Paper runs from screen/tmux/a shell script: copy this file and replace every
# placeholder (User, WorkingDirectory, jar name, -Xms/-Xmx) with the real values before
# installing to /etc/systemd/system/minecraft.service.
[Unit]
Description=Paper Minecraft server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# [INSTALLER] placeholders: real user/group, real server folder, real jar name and memory flags
User=minecraft
Group=minecraft
WorkingDirectory=/opt/minecraft
ExecStart=/usr/bin/java -Xms4G -Xmx4G -jar paper.jar --nogui
# Paper shuts down cleanly on SIGINT; give large worlds time to save.
KillSignal=SIGINT
SuccessExitStatus=0 130 143
TimeoutStopSec=120
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
