# Environment for the dashboard service. Install as /etc/homelab-dashboard.env
# (owner root, group homelab, mode 0640).
#
# [INSTALLER] EVERY VALUE IN THIS FILE IS A PLACEHOLDER. Replace each with what the
# live server actually uses — container names from `docker ps`, the unit name from
# `systemctl list-units`, real paths from `docker inspect` / the Paper folder, the
# Tailscale name from `tailscale status`. Do not assume any default is right.

# --- network / auth --------------------------------------------------------
# Bind to loopback only; `tailscale serve` is the only way in.
HOST=127.0.0.1
PORT=3000
# Comma-separated Tailscale logins allowed to use the dashboard (as shown by
# `tailscale status`, e.g. you@github or you@gmail.com). Empty = anyone on the tailnet.
ALLOWED_LOGINS=
# Where jobs.json / job-runs.json live
DATA_DIR=/opt/homelab-dashboard/data
TZ=America/Chicago

# --- Jellyfin (Docker) -----------------------------------------------------
JELLYFIN_URL=http://127.0.0.1:8096
# Address users open in a browser (Tailscale MagicDNS name or 100.x IP)
JELLYFIN_PUBLIC_URL=http://homeserver:8096
# REQUIRED for sessions/counts: Jellyfin → Dashboard → Advanced → API Keys
JELLYFIN_API_KEY=
# `docker ps` name of the Jellyfin container
JELLYFIN_CONTAINER=jellyfin
# REQUIRED for the Media files page: Name=/host/path, comma-separated. These are
# the host directories that are mounted into the Jellyfin container.
MEDIA_ROOTS=Movies=/srv/media/movies,Shows=/srv/media/shows,Music=/srv/media/music

# --- Minecraft (native Paper) ----------------------------------------------
MC_SERVICE=minecraft
# Quote paths that contain spaces, e.g. MC_DIR="/home/gold/Minecraft Server"
MC_DIR=/opt/minecraft
MC_HOST=127.0.0.1
MC_PORT=25565
# Shown to players in the UI
MC_PUBLIC_ADDRESS=homeserver.tail1234.ts.net
RCON_HOST=127.0.0.1
RCON_PORT=25575
# REQUIRED: must match rcon.password in server.properties
RCON_PASSWORD=
# Where EXISTING backups live (comma-separated roots; the first is where new ones go).
# Recognised: mc-YYYYMMDD-HHMMSS.tar.gz, mcworld_YYYY_MM_DD/<x>.tar.gz folders, *.tar.gz
BACKUP_DIR=/var/backups/minecraft
# Retention applies only to backups the dashboard itself created
BACKUP_KEEP=7
# What "Back up now" / backup jobs run: builtin, or script:<name> from SCRIPTS_DIR
BACKUP_METHOD=builtin
# Built-in layout: archive (mc-….tar.gz) or dated-folder (mcworld_YYYY_MM_DD/<world>.tar.gz)
BACKUP_FORMAT=archive

# --- Directus / PostgreSQL (docker compose in this repo) -------------------
DIRECTUS_URL=http://127.0.0.1:8055
DIRECTUS_PUBLIC_URL=http://homeserver:8055
DIRECTUS_CONTAINER=homelab-directus
POSTGRES_CONTAINER=homelab-postgres
# Same credentials as the compose .env; Postgres is published on 127.0.0.1 only.
PG_URL=postgres://homelab:CHANGE-ME@127.0.0.1:5432/personal

# --- Live Server Alerts, scripts, agents -----------------------------------
# REQUIRED for scripts and the MCP connector. A locally generated password for
# the dashboard's own API — NOT an Anthropic/OpenAI key. Generate: openssl rand -hex 24
DASHBOARD_KEY=
# Folder(s) with the owner's maintenance scripts (*.py, *.sh), comma-separated. They appear
# as ▶ buttons, can be scheduled as jobs, and their output streams into the alerts feed.
# `npm run discover` suggests the real folders. A missing folder is reported loudly in the UI.
# e.g. SCRIPTS_DIR="/home/gold/Minecraft Server/scripts,/opt/homelab-scripts"
SCRIPTS_DIR=/opt/homelab-scripts
# Instructions & context file agents read (edited from the Assistant widget).
CONTEXT_FILE=/opt/homelab-dashboard/CLAUDE.md
# Log sources the alerts hub tails continuously (default: all six).
ALERT_SOURCES=minecraft,jellyfin,directus,postgres,dashboard,system

# --- VPN tab ---------------------------------------------------------------
# [INSTALLER] Which VPN runs on the server is unknown. auto = probe for mullvad /
# nordvpn / protonvpn CLIs and WireGuard/tun interfaces. Set explicitly once known.
VPN_PROVIDER=auto
# The VPN's network interface (ip -d link): e.g. wg0-mullvad, nordlynx, proton0, tun0
VPN_INTERFACE=
# The physical/LAN interface (e.g. eth0). Lets the page show the home ISP IP next to the
# VPN exit IP and detect "connected but not actually tunnelling". Optional.
VPN_LAN_INTERFACE=
# Geolocation API for exit/endpoint IPs. ipinfo.io works without a token at low volume;
# add VPN_GEO_TOKEN for a free account, or point at another {url}/json-compatible service.
VPN_GEO_URL=https://ipinfo.io
VPN_GEO_TOKEN=
# Split-tunnel exceptions the owner KNOWS exist, if detection can't see them:
# VPN_EXCEPTIONS=Minecraft=25565/tcp,Jellyfin=8096/tcp
VPN_EXCEPTIONS=

# --- misc ------------------------------------------------------------------
DASHBOARD_SERVICE=homelab-dashboard
DOCKER_SOCKET=/var/run/docker.sock
