# Environment for the dashboard service. Install as /etc/homelab-dashboard.env
# (owner root, group homelab, mode 0640).
#
# [INSTALLER] EVERY VALUE IN THIS FILE IS A PLACEHOLDER. Replace each with what the
# live server actually uses — container names from `docker ps`, the unit name from
# `systemctl list-units`, real paths from `docker inspect` / the Paper folder, the
# Tailscale name from `tailscale status`. Do not assume any default is right.

# --- network / auth --------------------------------------------------------
# Bind to loopback only; `tailscale serve` is the only way in.
HOST=127.0.0.1
PORT=3000
# Optional: opens the existing router login in a new tab; no router credentials are stored.
# Replace with your LAN gateway. The link may not work away from your home network.
# ROUTER_URL=http://192.168.1.1
# Comma-separated Tailscale logins allowed to use the dashboard (as shown by
# `tailscale status`, e.g. you@github or you@gmail.com). Empty = anyone on the tailnet.
ALLOWED_LOGINS=
# Reach the dashboard from anywhere through the Cloudflare Tunnel behind Cloudflare Access
# (GitHub login + 2FA; SERVER_SETUP § 7b). Leave unset until that section is done; then the
# dashboard verifies every Cloudflare-routed request's Access token itself (second lock).
# CF_ACCESS_TEAM_DOMAIN=xgold-tech.cloudflareaccess.com
# CF_ACCESS_AUD=<Application Audience (AUD) tag of the "Homelab dashboard" Access app>
# PUBLIC_DASHBOARD_URL=https://dash.xgold.tech
# Where jobs.json / job-runs.json live
DATA_DIR=/opt/homelab-dashboard/data
TZ=America/Chicago

# --- Jellyfin (Docker) -----------------------------------------------------
JELLYFIN_URL=http://127.0.0.1:8096
# Address users open in a browser (Tailscale MagicDNS name or 100.x IP)
JELLYFIN_PUBLIC_URL=http://homeserver:8096
# REQUIRED for sessions/counts: Jellyfin → Dashboard → Advanced → API Keys
JELLYFIN_API_KEY=
# `docker ps` name of the Jellyfin container
JELLYFIN_CONTAINER=jellyfin
# REQUIRED for the Media files page: Name=/host/path, comma-separated. These are
# the host directories that are mounted into the Jellyfin container.
MEDIA_ROOTS=Movies=/srv/media/movies,Shows=/srv/media/shows,Music=/srv/media/music

# --- Minecraft (native Paper) ----------------------------------------------
MC_SERVICE=minecraft
# Quote paths that contain spaces, e.g. MC_DIR="/home/gold/Minecraft Server"
MC_DIR=/opt/minecraft
MC_HOST=127.0.0.1
MC_PORT=25565
# Shown to players in the UI
MC_PUBLIC_ADDRESS=homeserver.tail1234.ts.net
RCON_HOST=127.0.0.1
RCON_PORT=25575
# REQUIRED: must match rcon.password in server.properties
RCON_PASSWORD=
# Where EXISTING backups live (comma-separated roots; the first is where new ones go).
# Recognised: mc-YYYYMMDD-HHMMSS.tar.gz, mcworld_YYYY_MM_DD/<x>.tar.gz folders, *.tar.gz
BACKUP_DIR=/var/backups/minecraft
# Retention applies only to backups the dashboard itself created
BACKUP_KEEP=7
# What "Back up now" / backup jobs run: builtin, or script:<name> from SCRIPTS_DIR
BACKUP_METHOD=builtin
# Built-in layout: archive (mc-….tar.gz) or dated-folder (mcworld_YYYY_MM_DD/<world>.tar.gz)
BACKUP_FORMAT=archive

# --- Directus / PostgreSQL (docker compose in this repo) -------------------
DIRECTUS_URL=http://127.0.0.1:8055
DIRECTUS_PUBLIC_URL=http://homeserver:8055
DIRECTUS_CONTAINER=homelab-directus
POSTGRES_CONTAINER=homelab-postgres
# Same credentials as the compose .env; Postgres is published on 127.0.0.1 only.
PG_URL=postgres://homelab:CHANGE-ME@127.0.0.1:5432/personal

# --- Live Server Alerts, scripts, agents -----------------------------------
# REQUIRED for scripts and the MCP connector. A locally generated password for
# the dashboard's own API — NOT an Anthropic/OpenAI key. Generate: openssl rand -hex 24
# `sudo npm run wrap-service -- --install-hl-run` copies it (with the URL) into
# /etc/homelab-hl-run.env so cron lines and systemd units wrapped with hl-run can report
# without this whole file being exposed to them.
DASHBOARD_KEY=
# Optional model override for dashboard Codex jobs; leave unset to use CLI config.
# [INSTALLER] Set this to a model available to the service user's signed-in account.
# CODEX_MODEL=your-available-model
# Folder(s) with the owner's maintenance scripts (*.py, *.sh), comma-separated. They appear
# as ▶ buttons, can be scheduled as jobs, and their output streams into the alerts feed.
# `npm run discover` suggests the real folders. A missing folder is reported loudly in the UI.
# e.g. SCRIPTS_DIR="/home/gold/Minecraft Server/scripts,/opt/homelab-scripts"
SCRIPTS_DIR=/opt/homelab-scripts
# Instructions & context file agents read (edited from the Assistant widget).
CONTEXT_FILE=/opt/homelab-dashboard/CLAUDE.md
# Log sources the alerts hub tails continuously (default: all six).
ALERT_SOURCES=minecraft,jellyfin,directus,postgres,dashboard,system

# --- VPN tab ---------------------------------------------------------------
# [INSTALLER] Which VPN runs on the server is unknown. auto = probe for mullvad /
# nordvpn / protonvpn CLIs and WireGuard/tun interfaces. Set explicitly once known.
VPN_PROVIDER=auto
# The VPN's network interface (ip -d link): e.g. wg0-mullvad, nordlynx, proton0, tun0
VPN_INTERFACE=
# The physical/LAN interface (e.g. eth0). Lets the page show the home ISP IP next to the
# VPN exit IP and detect "connected but not actually tunnelling". Optional.
VPN_LAN_INTERFACE=
# Geolocation API for exit/endpoint IPs. ipinfo.io works without a token at low volume;
# add VPN_GEO_TOKEN for a free account, or point at another {url}/json-compatible service.
VPN_GEO_URL=https://ipinfo.io
VPN_GEO_TOKEN=
# Split-tunnel exceptions the owner KNOWS exist, if detection can't see them:
# VPN_EXCEPTIONS=Minecraft=25565/tcp,Jellyfin=8096/tcp
VPN_EXCEPTIONS=

# --- misc ------------------------------------------------------------------
DASHBOARD_SERVICE=homelab-dashboard
DOCKER_SOCKET=/var/run/docker.sock

# ---- Storage explorer (System → Storage) ---------------------------------------------
# The TreeSize view is fed by ncdu (sudo apt install ncdu) or gdu; du -a is the fallback.
# auto = ncdu → gdu → du. Scans every df mount by default; one scan at a time, in the background.
DISK_SCANNER=auto
# DISK_SCAN_ROOTS=/,/srv/media,/var/backups
DISK_SCAN_INTERVAL_HOURS=24
# DISK_SCAN_EXCLUDE=/var/lib/docker/overlay2,*.sock

# ---- Staged update widget (Minecraft tab) --------------------------------------------
# [INSTALLER] Where the update-fetch job puts new Paper/plugin jars before the restart applies
# them. Read the fetch script to find it. Unset = plugins/update, updates, staged, staging under MC_DIR.
# UPDATE_STAGING_DIR="/home/gold/Minecraft Server/plugins/update"
# Upstream source per plugin (modrinth:<slug> | hangar:<owner>/<slug> | github:<owner>/<repo> | none)
# PLUGIN_SOURCES=EssentialsX=modrinth:essentialsx,Chunky=hangar:pop4959/Chunky,Vault=github:MilkBowl/Vault
UPDATE_CHECK=1

# ---- Database apps + Cloudflare Tunnel (SERVER_SETUP § 5) -------------------------------
# App names (= Postgres database + role + Directus instance each). Must match APPS in the compose .env.
APPS=fam,ai,crm
# Kind per app: directus (default) or twenty. crm is the Twenty CRM at https://crm.<PUBLIC_DOMAIN> (127.0.0.1:3020)
APP_CRM_KIND=twenty
# Each app's Directus is https://<name>-api.<PUBLIC_DOMAIN> through the tunnel; https://<name>.<PUBLIC_DOMAIN> is its front-end
PUBLIC_DOMAIN=xgold.tech
# Per app (defaults shown; only set when different): APP_FAM_URL=http://127.0.0.1:8056  APP_AI_URL=http://127.0.0.1:8057
# APP_FAM_PUBLIC_URL=https://fam-api.xgold.tech  APP_FAM_SITE_URL=https://fam.xgold.tech  APP_FAM_CONTAINER=homelab-directus-fam  APP_FAM_DB=fam
# Domain & hostnames card (SERVER_SETUP § 6h). Read-only token: Zone·Zone·Read + Zone·DNS·Read, this zone only.
# CLOUDFLARE_API_TOKEN=
# DNS_ZONE_FILE=/opt/homelab-dashboard/deploy/dns/xgold.tech.zone   (default; used when no token)
# HOSTNAMES_EXTRA=crm
# Where scripts/pg-backup.sh writes dumps, and how the script finds the compose .env (POSTGRES_USER)
PG_BACKUP_DIR=/var/backups/postgres
OFFSITE_BACKUP_RECEIPT=/var/backups/postgres/last-verified.json
PG_BACKUP_KEEP=14
COMPOSE_ENV=/opt/homelab-dashboard/.env
CLOUDFLARED_CONTAINER=homelab-cloudflared
CLOUDFLARED_METRICS_URL=http://127.0.0.1:2000
# Optional qBittorrent API connection for the dashboard's Add Torrent Link button.
# Server-side URL; the browser never connects to this address.
# QBITTORRENT_URL=http://127.0.0.1:8080
# Set credentials when the local API requires a WebUI login.
# QBITTORRENT_USERNAME=admin
# QBITTORRENT_PASSWORD=

# Optional Umami analytics card; append umami to APPS.
APP_UMAMI_KIND=umami
APP_UMAMI_URL=http://127.0.0.1:3021
APP_UMAMI_PUBLIC_URL=https://crm.xgold.tech/stats
APP_UMAMI_CONTAINER=homelab-umami
APP_UMAMI_DB=umami

# Geyser-Spigot and floodgate use their official build API automatically.
# Optional explicit overrides: PLUGIN_SOURCES=Geyser-Spigot=geyser:geyser,floodgate=geyser:floodgate
